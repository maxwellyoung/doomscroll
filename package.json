{
  "name": "doomscroll",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "deck:export-local": "node scripts/export-local-deck.mjs",
    "audiobook:build": ".venv/bin/python scripts/build_audiobook.py",
    "audiobook:rehearsal": ".venv/bin/python scripts/build_audiobook.py --cut rehearsal",
    "audiobook:rehearsal:bobby": ".venv/bin/python scripts/build_audiobook.py --cut rehearsal --variant bobby-aggressive",
    "audiobook:rehearsal:standup": ".venv/bin/python scripts/build_audiobook.py --cut rehearsal --variant standup-30sec",
    "audiobook:rehearsal:review": ".venv/bin/python scripts/build_audiobook.py --cut rehearsal --variant review-defense",
    "fallow": "npx --yes fallow",
    "fallow:dead-code": "npx --yes fallow dead-code",
    "fallow:dupes": "npx --yes fallow dupes",
    "fallow:health": "npx --yes fallow health",
    "fallow:audit": "npx --yes fallow audit",
    "fallow:fix:dry-run": "npx --yes fallow fix --dry-run"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
